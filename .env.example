# === Скопируйте этот файл в .env и заполните значениями от владельца ===

# Токен Telegram-бота (от @BotFather)
TELEGRAM_BOT_TOKEN=

# Токен MAX-бота (из кабинета разработчика dev.max.ru)
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform.max.ru/api-v1
MAX_WEBHOOK_PATH=/max/webhook
# Секретная подпись для webhook MAX (по желанию) + она же защита /admin/flush
MAX_WEBHOOK_SECRET=

# Получатель заявок — владелец (chat_id его личного чата с ботом-оповещателем в MAX)
OWNER_MAX_USER_ID=
# Опциональный дубль владельцу в Telegram
OWNER_TELEGRAM_ID=

# Google Таблица для дубля заявок
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service_account.json
GOOGLE_SHEETS_WORKSHEET=Лист1

# Публичный адрес поддомена на Sweb
WEBHOOK_BASE_URL=https://bot.neurodelo.pro
PORT=8080

# TTL брошенной анкеты в секундах (по умолчанию 24 часа)
SESSION_TTL_SECONDS=86400
TIMEZONE=Europe/Moscow
DEBUG=false
